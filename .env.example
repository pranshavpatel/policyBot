# Copy to .env and fill in real values. Never commit .env.

# --- LLM ---
LLM_PROVIDER=groq   # groq | local (any OpenAI-compatible server — see agent/llm.py)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# LLM_PROVIDER=local only — any OpenAI-compatible server (Ollama, vLLM,
# llama.cpp's server). Defaults match Ollama running locally; point
# LOCAL_LLM_BASE_URL at a GPU workstation's reachable address to run
# inference there instead.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_LLM_API_KEY=ollama
# Per-call bounds so one runaway generation can't hang the server
# (see config.py). The token cap includes thinking tokens.
LOCAL_LLM_MAX_TOKENS=4096
LOCAL_LLM_TIMEOUT_SECONDS=180

# --- Embeddings ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_DIR=vectorstore/chroma_policybot
RETRIEVAL_MODE=dense   # dense | hybrid

# Cross-encoder reranking on top of RETRIEVAL_MODE (see rag/reranker.py).
# Off by default: real CPU latency per query, ~90MB model download on
# first use.
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=15

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# --- Slack (optional) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
# The Slack bot authenticates to the API as this one shared account (see
# slack/slack_app.py for why — Slack users aren't individually mapped yet).
POLICYBOT_SERVICE_USERNAME=manager1
POLICYBOT_SERVICE_PASSWORD=manager123
