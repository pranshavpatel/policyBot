# Copy to .env and fill in real values. Never commit .env.

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Embeddings ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_DIR=vectorstore/chroma_policybot
RETRIEVAL_MODE=dense   # dense | hybrid

# Cross-encoder reranking on top of RETRIEVAL_MODE (see rag/reranker.py).
# Off by default: real CPU latency per query, ~90MB model download on
# first use.
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=15

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# --- Slack (optional) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
# The Slack bot authenticates to the API as this one shared account (see
# slack/slack_app.py for why — Slack users aren't individually mapped yet).
POLICYBOT_SERVICE_USERNAME=manager1
POLICYBOT_SERVICE_PASSWORD=manager123
